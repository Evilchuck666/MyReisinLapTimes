# dotnet build output (MyReisinLapTimes.csproj sits at the root)
/bin/
/obj/

# dotnet publish output: the "Publish single-file .exe" task writes to dist/publish
/dist/

# Visual Studio (an alternative to the .NET SDK in TECHNICAL_GUIDE.md): its cache folder and the per-user files
# it writes next to the project, such as MyReisinLapTimes.csproj.user
/.vs/
*.user

# Files Windows Explorer drops into folders, for instance next to the images in assets/ and site/screenshots/
Thumbs.db
desktop.ini

# Personal Claude Code files
CLAUDE.local.md
.claude/settings.local.json
